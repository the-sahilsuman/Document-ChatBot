
---

## `.gitignore`

```gitignore
# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class
*.so

# =========================
# Virtual Environment
# =========================

venv/
env/
.venv/
document-chatbot/

# =========================
# Environment Variables
# =========================

.env
.env.*
!.env.example

# =========================
# ChromaDB
# =========================

chroma_db/
*.sqlite3
*.sqlite

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# OS Files
# =========================

.DS_Store
Thumbs.db

# =========================
# IDE
# =========================

.vscode/
.idea/

# =========================
# Logs
# =========================

*.log

# =========================
# Temporary Files
# =========================

*.tmp
*.temp

# =========================
# Python Packaging
# =========================

build/
dist/
*.egg-info/
.eggs/

# =========================
# Testing / Coverage
# =========================

.pytest_cache/
.coverage
htmlcov/

.deepeval/